{
  "name": "snp-inventory",
  "version": "1.0.0",
  "description": "Shapes and Pieces jewellery inventory manager",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/pricing.test.ts tests/database.test.ts tests/sku.test.ts tests/migration.test.mjs tests/auth-config.test.mjs tests/inventory-summary.test.ts",
    "test:e2e": "playwright test",
    "password:hash": "node scripts/password-hash.mjs",
    "backfill:skus": "node --env-file=.env.local --import tsx scripts/backfill-skus.ts",
    "prebuild": "node scripts/migrate.mjs --build",
    "db:migrate": "node scripts/migrate.mjs",
    "test:auth:production": "node --test tests/production-login.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@neondatabase/serverless": "^1.2.0",
    "@zxing/browser": "^0.2.1",
    "bwip-js": "^4.11.4",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  }
}
